<Window x:Class="RestaurantManagement.WPF.EditEmployeeNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa họ tên nhân viên"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Họ tên nhân viên" Margin="0,0,0,6" />
        <TextBox x:Name="FullNameTextBox" MinWidth="340" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Lưu" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" />
        </WrapPanel>
    </StackPanel>
</Window>
