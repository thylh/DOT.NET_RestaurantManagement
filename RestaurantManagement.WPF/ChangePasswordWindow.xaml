<Window x:Class="RestaurantManagement.WPF.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestaurantManagement.WPF"
        xmlns:behaviors="clr-namespace:RestaurantManagement.WPF.Behaviors"
        Title="Đổi mật khẩu"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Mật khẩu hiện tại" Margin="0,0,0,6" />
        <PasswordBox x:Name="CurrentPasswordBox"
                     MinWidth="360"
                     behaviors:PasswordBoxPlaceholderBehavior.PlaceholderText="Nhập mật khẩu hiện tại"
                     Margin="0,0,0,14" />
        <TextBlock Text="Mật khẩu mới (ít nhất 12 ký tự)" Margin="0,0,0,6" />
        <PasswordBox x:Name="NewPasswordBox"
                     behaviors:PasswordBoxPlaceholderBehavior.PlaceholderText="Nhập mật khẩu mới"
                     Margin="0,0,0,18" />
        <local:NotificationBanner Message="{Binding ErrorMessage}"
                                  Kind="Error"
                                  Margin="0,0,0,14"/>
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="Hủy" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Lưu" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" />
        </WrapPanel>
    </StackPanel>
</Window>
