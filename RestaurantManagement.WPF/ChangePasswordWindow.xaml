<Window x:Class="RestaurantManagement.WPF.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestaurantManagement.WPF"
        xmlns:behaviors="clr-namespace:RestaurantManagement.WPF.Behaviors"
        Title="Đổi mật khẩu"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Margin="16"
            Style="{StaticResource OpenBottomFrameStyle}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.10" Color="#542B1C" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Đổi mật khẩu"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Cập nhật mật khẩu cá nhân để bảo vệ tài khoản của bạn."
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,20" />

            <TextBlock Text="Mật khẩu hiện tại"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="CurrentPasswordBox"
                         behaviors:PasswordBoxPlaceholderBehavior.PlaceholderText="Nhập mật khẩu hiện tại"
                         Margin="0,0,0,16" />

            <TextBlock Text="Mật khẩu mới (ít nhất 12 ký tự)"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="NewPasswordBox"
                         behaviors:PasswordBoxPlaceholderBehavior.PlaceholderText="Nhập mật khẩu mới"
                         Margin="0,0,0,16" />

            <local:NotificationBanner Message="{Binding ErrorMessage}"
                                      Kind="Error"
                                      UseOpenBottomFrame="True"
                                      Margin="0,0,0,16"/>

            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Hủy"
                        IsCancel="True"
                        MinWidth="85"
                        Padding="14,8"
                        Margin="0,0,10,0" />
                <Button Content="Lưu"
                        IsDefault="True"
                        Click="Save_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="95"
                        Padding="16,8" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
