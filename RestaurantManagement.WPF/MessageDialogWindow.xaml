<Window x:Class="RestaurantManagement.WPF.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border Margin="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#542B1C" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="22,20,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="KindBadge" Width="36" Height="36" CornerRadius="10"
                            Background="{StaticResource PrimaryTintBrush}" Margin="0,0,12,0">
                        <TextBlock x:Name="KindGlyph" Text="i" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Width="32" Height="32" MinHeight="0"
                        Padding="0" FontSize="18" Click="Close_Click"
                        IsCancel="True" ToolTip="Đóng" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap"
                       Margin="70,14,24,24" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14" />
            <WrapPanel x:Name="ConfirmationButtons" Grid.Row="2" HorizontalAlignment="Right"
                       Margin="0,0,22,20" Visibility="Collapsed">
                <Button Content="Không" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Content="Xác nhận" IsDefault="True" MinWidth="90"
                        Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}" />
            </WrapPanel>
            <Button x:Name="OkButton" Grid.Row="2" Content="Đóng" IsDefault="True"
                    IsCancel="True" MinWidth="90" HorizontalAlignment="Right"
                    Margin="0,0,22,20" Click="Close_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Border>
</Window>
