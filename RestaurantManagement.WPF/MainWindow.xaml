<Window x:Class="RestaurantManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestaurantManagement.WPF"
        xmlns:behaviors="clr-namespace:RestaurantManagement.WPF.Behaviors"
        xmlns:viewModels="clr-namespace:RestaurantManagement.WPF.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static viewModels:MainWindowViewModel.Title}"
        Height="720"
        Width="1440"
        MinHeight="620"
        MinWidth="1120"
        behaviors:DataGridSelectionBehavior.IsEnabled="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="StateSwitchStyle" TargetType="{x:Type ToggleButton}">
            <EventSetter Event="Click" Handler="StateSwitch_Click"/>
            <Setter Property="Width" Value="29"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="MinWidth" Value="29"/>
            <Setter Property="MinHeight" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="ToolTip" Value="Bật hoặc tắt trạng thái"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="29" Height="17" Background="Transparent">
                            <Border x:Name="SwitchTrack"
                                    Width="29" Height="17"
                                    Background="{StaticResource BorderBrush}"
                                    CornerRadius="9"/>
                            <Ellipse x:Name="SwitchThumb"
                                     Width="12" Height="12"
                                     Fill="{StaticResource SurfaceBrush}"
                                     HorizontalAlignment="Left"
                                     Margin="2.5,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment"
                                        Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="OrderHistoryViewTemplate">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Lịch sử order và biên nhận"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <WrapPanel>
                        <TextBox Width="130"
                                 Text="{Binding OrderHistoryIdText, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Mã order"
                                 Margin="0,0,8,8"/>
                        <DatePicker SelectedDate="{Binding OrderHistoryFromDate}"
                                    ToolTip="Từ ngày tạo order"
                                    Margin="0,0,8,8"/>
                        <DatePicker SelectedDate="{Binding OrderHistoryToDate}"
                                    ToolTip="Đến hết ngày tạo order"
                                    Margin="0,0,8,8"/>
                        <Button Content="Tra cứu"
                                Command="{Binding SearchOrderHistoryCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,7"
                                Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource DataGridFrameStyle}">
                        <DataGrid ItemsSource="{Binding OrderHistory}"
                                  SelectedItem="{Binding SelectedOrderHistory}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MinHeight="0"
                                  SelectionUnit="FullRow"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã"
                                                    Binding="{Binding OrderId}"
                                                    Width="0.55*"/>
                                <DataGridTextColumn Header="Thời gian"
                                                    Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                    Width="1.45*"/>
                                <DataGridTextColumn Header="Bàn"
                                                    Binding="{Binding TableNumber}"
                                                    Width="0.8*"/>
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding StatusDisplay}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Thành tiền"
                                                    Binding="{Binding Total, StringFormat={}{0:N0}}"
                                                    Width="1*"/>
                                <DataGridTextColumn Header="Thanh toán"
                                                    Binding="{Binding PaymentMethodDisplay}"
                                                    Width="1.1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14">
                        <StackPanel>
                                <TextBlock Text="{Binding CurrentOrderReceipt.OrderId, StringFormat=Chi tiết order #{0}}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Trạng thái: " FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentOrderReceipt.StatusDisplay}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentOrderReceipt.CancellationReason, StringFormat=Lý do hủy: {0}}"
                                               TextWrapping="Wrap"
                                               Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentOrderReceipt.IsCancelled}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bàn: " FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentOrderReceipt.TableNumber}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Khu vực: "
                                               FontWeight="SemiBold"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding CurrentOrderReceipt.Area}"/>
                                </Grid>
                                <TextBlock Text="{Binding CurrentOrderReceipt.EmployeeName, StringFormat=Nhân viên: {0}}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentOrderReceipt.CreatedAt, StringFormat=Ngày tạo: {0:dd/MM/yyyy HH:mm}}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentOrderReceipt.PaidAt, StringFormat=Ngày thanh toán: {0:dd/MM/yyyy HH:mm}, TargetNullValue=Chưa thanh toán}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CurrentOrderReceipt.PaymentMethodDisplay, StringFormat=Phương thức: {0}}"
                                           Margin="0,0,0,8"/>
                                <Border Style="{StaticResource DataGridFrameStyle}"
                                        Margin="0,0,0,8">
                                    <DataGrid ItemsSource="{Binding CurrentOrderReceipt.Details}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HorizontalAlignment="Stretch"
                                              MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Món"
                                                                Binding="{Binding ProductName}"
                                                                Width="2*"
                                                                MinWidth="100"/>
                                            <DataGridTextColumn Header="SL"
                                                                Binding="{Binding Quantity}"
                                                                Width="0.65*"
                                                                MinWidth="45"/>
                                            <DataGridTextColumn Header="Đơn giá"
                                                                Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                                                Width="1.2*"
                                                                MinWidth="80"/>
                                            <DataGridTextColumn Header="Thành tiền"
                                                                Binding="{Binding LineTotal, StringFormat={}{0:N0}}"
                                                                Width="1.4*"
                                                                MinWidth="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <TextBlock Text="{Binding CurrentOrderReceipt.PromotionDisplay}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentOrderReceipt.Subtotal, StringFormat=Tạm tính: {0:N0} đ}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CurrentOrderReceipt.DiscountAmount, StringFormat=Giảm giá: -{0:N0} đ}"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CurrentOrderReceipt.Total, StringFormat=Thành tiền: {0:N0} đ}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
        <Style x:Key="ProductTagsDropDownButtonStyle"
                TargetType="{x:Type ToggleButton}">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="MinHeight"
                    Value="40"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="TagsButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                                <Path Grid.Column="1"
                                        Width="9"
                                        Height="5"
                                      HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                      Data="M 0 0 L 4.5 4.5 L 9 0"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                        StrokeLineJoin="Round"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="TagsButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin"
                                    Value="True">
                                <Setter TargetName="TagsButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="TagsButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="TagsButtonBorder"
                                        Property="Opacity"
                                        Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductTagCheckBoxStyle"
                TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                                    Width="17"
                                    Height="17"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                        Data="M 3 8 L 7 12 L 14 4"
                                      Stroke="{StaticResource SurfaceBrush}"
                                        StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                        Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                    ContentSource="Content"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30,30,30,0">
        <Grid Margin="0,0,0,30"
              Visibility="{Binding IsSetupScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="1050"
                    MinHeight="560"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36"
                            ShadowDepth="8"
                            Opacity="0.12"
                            Color="#542B1C"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            CornerRadius="24,0,0,24"
                            ClipToBounds="True">
                        <Grid Background="{StaticResource PrimaryBrush}">
                            <Ellipse Width="390"
                                    Height="390"
                                    Fill="#1FFFFFFF"
                                     HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-150,-120,0"/>
                            <Ellipse Width="290"
                                    Height="290"
                                    Fill="#16FFFFFF"
                                     HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="-110,0,0,-100"/>
                            <StackPanel Margin="54"
                                    VerticalAlignment="Center">
                                <Border Width="148"
                                        Height="148"
                                        CornerRadius="22"
                                        Background="{StaticResource SurfaceBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,26"
                                        Padding="8">
                                    <Image x:Name="SetupBrandLogo"
                                            Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="DineEase · QUẢN LÝ NHÀ HÀNG"
                                        Foreground="#F6C28E"
                                        FontSize="12"
                                           FontWeight="Bold"
                                        Margin="0,0,0,14"/>
                                <TextBlock Text="Vận hành gọn gàng.&#10;Phục vụ tận tâm."
                                           Foreground="White"
                                        FontSize="34"
                                        FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                        LineHeight="43"
                                        Margin="0,0,0,18"/>
                                <TextBlock Text="Một nơi tập trung cho đội ngũ và hoạt động mỗi ngày."
                                           Foreground="#F4E7D8"
                                        FontSize="15"
                                        TextWrapping="Wrap"
                                        MaxWidth="360"/>
                                <StackPanel Margin="0,36,0,0">
                                    <TextBlock Text="●   Quản lý bàn và thực đơn"
                                            Foreground="#FFF8EF"
                                            Margin="0,0,0,12"/>
                                    <TextBlock Text="●   Phân quyền theo vai trò"
                                            Foreground="#FFF8EF"
                                            Margin="0,0,0,12"/>
                                    <TextBlock Text="●   Dữ liệu lưu trên thiết bị của bạn"
                                            Foreground="#FFF8EF"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="54">
                        <TextBlock Text="Bắt đầu sử dụng"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Margin="0,0,0,8"/>
                        <TextBlock Text="Thiết lập Admin lần đầu"
                                FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,28"/>
                        <TextBlock Text="Tên đăng nhập"
                                FontWeight="SemiBold"
                                Margin="0,0,0,6"/>
                        <TextBox Text="{Binding SetupUsername, UpdateSourceTrigger=PropertyChanged}"
                                behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tên đăng nhập Admin"
                                Margin="0,0,0,18"/>
                        <TextBlock Text="Mật khẩu"
                                FontWeight="SemiBold"
                                Margin="0,0,0,6"/>
                        <PasswordBox x:Name="SetupPasswordBox"
                                Tag="setup"
                                behaviors:PasswordBoxPlaceholderBehavior.PlaceholderText="Nhập mật khẩu Admin"
                                PasswordChanged="PasswordBox_PasswordChanged"
                                Margin="0,0,0,10"/>
                        <TextBlock Text="Dùng ít nhất 12 ký tự để bảo vệ tài khoản."
                                FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,22"/>
                        <Button Content="Tạo tài khoản Admin"
                                Command="{Binding CreateInitialAdminCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"/>
                        <Grid Width="390"
                              HorizontalAlignment="Left"
                              Margin="0,14,0,0">
                            <local:NotificationBanner Message="{Binding ErrorMessage}"
                                                      Kind="Error"/>
                            <local:NotificationBanner Message="{Binding StatusMessage}"
                                                      Kind="Success"
                                                      IsSuppressed="{Binding HasError}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,30"
              Visibility="{Binding IsLoginScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="1050"
                    MinHeight="560"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36"
                            ShadowDepth="8"
                            Opacity="0.12"
                            Color="#542B1C"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            CornerRadius="24,0,0,24"
                            ClipToBounds="True">
                        <Grid Background="{StaticResource PrimaryBrush}">
                            <Ellipse Width="390"
                                    Height="390"
                                    Fill="#1FFFFFFF"
                                     HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-150,-120,0"/>
                            <Ellipse Width="290"
                                    Height="290"
                                    Fill="#16FFFFFF"
                                     HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="-110,0,0,-100"/>
                            <StackPanel Margin="54"
                                    VerticalAlignment="Center">
                                <Border Width="148"
                                        Height="148"
                                        CornerRadius="22"
                                        Background="{StaticResource SurfaceBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,26"
                                        Padding="8">
                                    <Image x:Name="LoginBrandLogo"
                                            Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="DineEase · QUẢN LÝ NHÀ HÀNG"
                                        Foreground="#F6C28E"
                                        FontSize="12"
                                           FontWeight="Bold"
                                        Margin="0,0,0,14"/>
                                <TextBlock Text="Vận hành gọn gàng.&#10;Phục vụ tận tâm."
                                           Foreground="White"
                                        FontSize="34"
                                        FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                        LineHeight="43"
                                        Margin="0,0,0,18"/>
                                <TextBlock Text="Một nơi tập trung cho đội ngũ và hoạt động mỗi ngày."
                                           Foreground="#F4E7D8"
                                        FontSize="15"
                                        TextWrapping="Wrap"
                                        MaxWidth="360"/>
                                <StackPanel Margin="0,36,0,0">
                                    <TextBlock Text="●   Quản lý bàn và thực đơn"
                                            Foreground="#FFF8EF"
                                            Margin="0,0,0,12"/>
                                    <TextBlock Text="●   Phân quyền theo vai trò"
                                            Foreground="#FFF8EF"
                                            Margin="0,0,0,12"/>
                                    <TextBlock Text="●   Dữ liệu lưu trên thiết bị của bạn"
                                            Foreground="#FFF8EF"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="54">
                        <TextBlock Text="Chào mừng trở lại"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Margin="0,0,0,8"/>
                        <TextBlock Text="Đăng nhập để tiếp tục quản lý nhà hàng"
                                   FontSize="15"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                TextWrapping="Wrap"
                                   Margin="0,0,0,28"/>
                        <TextBlock Text="Tên đăng nhập"
                                FontWeight="SemiBold"
                                Margin="0,0,0,6"/>
                        <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                                behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tên đăng nhập"
                                Margin="0,0,0,18"/>
                        <TextBlock Text="Mật khẩu"
                                FontWeight="SemiBold"
                                Margin="0,0,0,6"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                Tag="login"
                                behaviors:PasswordBoxPlaceholderBehavior.PlaceholderText="Nhập mật khẩu"
                                PasswordChanged="PasswordBox_PasswordChanged"
                                Margin="0,0,0,22"/>
                        <Button Content="Đăng nhập"
                                Command="{Binding SignInCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Grid Grid.Column="1"
                            VerticalAlignment="Bottom"
                          Margin="54,0,54,18"
                            Panel.ZIndex="1"
                            IsHitTestVisible="False">
                        <local:NotificationBanner Message="{Binding ErrorMessage}"
                                                  Kind="Error"
                                                  MaxHeight="120"/>
                        <local:NotificationBanner Message="{Binding StatusMessage}"
                                                  Kind="Success"
                                                  IsSuppressed="{Binding HasError}"
                                                  MaxHeight="120"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,30"
              Visibility="{Binding IsPasswordChangeRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="520"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="22"
                    Padding="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Đổi mật khẩu lần đầu"
                            FontSize="26"
                            FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Để bảo vệ tài khoản, bạn cần tạo mật khẩu riêng trước khi tiếp tục sử dụng."
                               Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap"
                               Margin="0,0,0,22"/>
                    <TextBlock Text="Mật khẩu tạm"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6"/>
                    <PasswordBox x:Name="RequiredCurrentPasswordBox"
                            Tag="current"
                            behaviors:PasswordBoxPlaceholderBehavior.PlaceholderText="Nhập mật khẩu tạm"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                            Margin="0,0,0,16"/>
                    <TextBlock Text="Mật khẩu mới (ít nhất 12 ký tự)"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6"/>
                    <PasswordBox x:Name="RequiredNewPasswordBox"
                            Tag="new"
                            behaviors:PasswordBoxPlaceholderBehavior.PlaceholderText="Nhập mật khẩu mới"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                            Margin="0,0,0,20"/>
                    <Button Content="Đổi mật khẩu và tiếp tục"
                            Command="{Binding ChangePasswordCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"/>
                    <local:NotificationBanner Message="{Binding ErrorMessage}"
                                              Kind="Error"
                                              Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsAuthenticatedWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                    Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                        Height="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="54"
                            Height="54"
                            CornerRadius="10"
                            Background="{StaticResource SurfaceBrush}"
                            Margin="0,0,10,0"
                            Padding="3"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Image x:Name="HeaderBrandLogo"
                                Stretch="Uniform"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                            Text="DineEase"
                            FontSize="16"
                            FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="2"
                            Margin="38,0,0,0"
                            VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                            Panel.ZIndex="1"
                            IsHitTestVisible="False">
                        <local:NotificationBanner Message="{Binding ErrorMessage}"
                                                  Kind="Error"
                                                  MaxWidth="520"/>
                        <local:NotificationBanner Message="{Binding StatusMessage}"
                                                  Kind="Success"
                                                  IsSuppressed="{Binding HasError}"
                                                  MaxWidth="520"/>
                    </Grid>
                </Grid>
                <Button Grid.Column="1"
                        x:Name="AccountMenuButton"
                        Click="AccountMenuButton_Click"
                        Padding="12,8"
                        Background="{StaticResource SurfaceMutedBrush}"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserDescription}"
                                   FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>
                        <Path Data="M0,0 L5,5 L10,0"
                              Stroke="{StaticResource PrimaryBrush}"
                                StrokeThickness="1.6"
                              Margin="12,0,2,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom"
                                     Background="{StaticResource SurfaceBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     Padding="6"
                                     HasDropShadow="False">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="{x:Type ContextMenu}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18"
                                                    ShadowDepth="4"
                                                              Opacity="0.18"
                                                    Color="#542B1C"/>
                                        </Border.Effect>
                                        <ItemsPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <ContextMenu.Resources>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="Padding"
                                            Value="14,10"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="MinWidth"
                                            Value="176"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type MenuItem}">
                                                <Border x:Name="MenuItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="7">
                                                    <ContentPresenter ContentSource="Header"
                                                                      RecognizesAccessKey="True"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted"
                                                            Value="True">
                                                        <Setter TargetName="MenuItemBorder"
                                                                Property="Background"
                                                                Value="{StaticResource PrimaryTintBrush}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource PrimaryBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled"
                                                            Value="False">
                                                        <Setter Property="Opacity"
                                                                Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="{x:Type Separator}">
                                    <Setter Property="Height"
                                            Value="1"/>
                                    <Setter Property="Margin"
                                            Value="10,4"/>
                                    <Setter Property="Background"
                                            Value="{StaticResource BorderBrush}"/>
                                </Style>
                            </ContextMenu.Resources>
                            <MenuItem Header="Đổi mật khẩu"
                                    Click="AccountChangePassword_Click"/>
                            <Separator/>
                            <MenuItem Header="Đăng xuất"
                                    Click="AccountSignOut_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
            <Border Grid.Row="1"
                    Background="{StaticResource PrimaryTintBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,9"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsReadOnlyStaff, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ReadOnlyStaffWarning}"
                           Foreground="{StaticResource PrimaryBrush}"
                        TextWrapping="Wrap"/>
            </Border>
            <ProgressBar Grid.Row="2"
                    IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TabControl x:Name="AdminWorkspaceTabs"
                    Grid.Row="3"
                        SelectedIndex="{Binding ManagementWorkspaceSelectedIndex}"
                        Visibility="{Binding IsManagementScreen, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0"
                    SelectionChanged="AdminTabs_SelectionChanged">
                <TabItem Header="Cấp tài khoản"
                         Visibility="{Binding IsAdminScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Cấp tài khoản đăng nhập cho nhân viên"
                                    FontSize="20"
                                       FontWeight="SemiBold"
                                    Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="Họ tên"/>
                                    <TextBox Text="{Binding AccountEmployeeName, UpdateSourceTrigger=PropertyChanged}"
                                            behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Họ tên nhân viên"
                                            Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="Điện thoại"/>
                                    <TextBox Text="{Binding AccountEmployeePhone, UpdateSourceTrigger=PropertyChanged}"
                                            behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Số điện thoại (không bắt buộc)"
                                            Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="Email"/>
                                    <TextBox Text="{Binding AccountEmployeeEmail, UpdateSourceTrigger=PropertyChanged}"
                                            behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Email (không bắt buộc)"
                                            Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="Vai trò"/>
                                    <ComboBox ItemsSource="{Binding AccountRoleOptions}"
                                              SelectedItem="{Binding AccountRoleToCreate}"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Tạo tài khoản"
                                    Command="{Binding CreateAccountCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,14"/>
                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tài khoản đã cấp"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                    <TextBox Width="260"
                                            Text="{Binding AccountSearchText, UpdateSourceTrigger=PropertyChanged}"
                                            behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tìm theo họ tên, tên đăng nhập, điện thoại hoặc email"
                                             Margin="8,0,0,0"/>
                                    <ComboBox Width="190"
                                            ItemsSource="{Binding AccountRoleFilters}"
                                              SelectedItem="{Binding SelectedAccountRoleFilter}"
                                              ToolTip="Lọc theo vai trò"
                                              Margin="8,0,0,0"/>
                                    <ComboBox Width="210"
                                            ItemsSource="{Binding AccountProfileFilters}"
                                              SelectedItem="{Binding SelectedAccountProfileFilter}"
                                              ToolTip="Lọc theo tình trạng hồ sơ"
                                              Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Row="1"
                                Style="{StaticResource DataGridFrameStyle}">
                            <DataGrid x:Name="AccountDataGrid"
                                      ItemsSource="{Binding FilteredAccounts}"
                                    SelectedItem="{Binding SelectedAccount}"
                                      AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                      CanUserReorderColumns="False"
                                    CanUserResizeColumns="False"
                                      RowDetailsVisibilityMode="VisibleWhenSelected"
                                      GridLinesVisibility="Vertical"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      MinHeight="0"
                                    Margin="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}"
                                           BasedOn="{StaticResource DataGridRowBaseStyle}">
                                        <EventSetter Event="PreviewMouseLeftButtonDown"
                                                     Handler="AccountRow_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp"
                                                     Handler="AccountRow_PreviewMouseLeftButtonUp"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="8,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding ProfileActionLabel}"
                                                        Tag="{Binding}"
                                                        Click="CreateEmployeeProfile_Click"
                                                        IsEnabled="{Binding CanCreateEmployeeProfile}"
                                                        Padding="12,7"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="Chỉnh sửa"
                                                        Tag="{Binding}"
                                                        Click="EditAccountEmployeeName_Click"
                                                        Padding="12,7"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="Xóa tài khoản"
                                                        Tag="{Binding}"
                                                        Click="DeleteAccount_Click"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="12,7"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Họ tên"
                                            Binding="{Binding FullName}"
                                            Width="2*"/>
                                    <DataGridTextColumn Header="Tên đăng nhập"
                                            Binding="{Binding Username}"
                                            Width="1.4*"/>
                                    <DataGridTemplateColumn Header="Mật khẩu tạm"
                                            Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right"
                                                            Click="CopyTemporaryPassword_Click"
                                                            IsEnabled="{Binding CanCopyTemporaryPassword}"
                                                            Width="30"
                                                            Height="30"
                                                            MinHeight="0"
                                                            Padding="6"
                                                            Margin="6,0,0,0"
                                                            ToolTip="Sao chép mật khẩu tạm"
                                                            AutomationProperties.Name="Sao chép mật khẩu tạm">
                                                        <Viewbox Width="14"
                                                                Height="14">
                                                            <Path Fill="{StaticResource PrimaryBrush}"
                                                                  Data="M16,1H4C2.9,1 2,1.9 2,3V17H4V3H16V1M19,5H8C6.9,5 6,5.9 6,7V21C6,22.1 6.9,23 8,23H19C20.1,23 21,22.1 21,21V7C21,5.9 20.1,5 19,5M19,21H8V7H19V21Z"/>
                                                        </Viewbox>
                                                    </Button>
                                                    <TextBlock Text="{Binding PasswordDisplay}"
                                                               VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Vai trò"
                                            Binding="{Binding RoleDisplay}"
                                            Width="*"/>
                                    <DataGridTextColumn Header="Hồ sơ nhân viên"
                                            Binding="{Binding EmployeeProfileStatusLabel}"
                                            Width="1.3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Nhân viên"
                         Visibility="{Binding IsManagementScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Danh sách nhân viên"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Margin="0,0,0,12"/>
                        <WrapPanel Grid.Row="1"
                                Margin="0,0,0,8">
                            <TextBox Width="300"
                                    Text="{Binding EmployeeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tìm theo họ tên, điện thoại, email hoặc tên đăng nhập"
                                     Margin="0,0,8,8"/>
                            <ComboBox Width="210"
                                    ItemsSource="{Binding EmployeeStatusFilters}"
                                      SelectedItem="{Binding SelectedEmployeeStatusFilter}"
                                      ToolTip="Lọc theo trạng thái làm việc"
                                      Margin="0,0,8,8"/>
                        </WrapPanel>
                        <Border Grid.Row="2"
                                Style="{StaticResource DataGridFrameStyle}">
                            <DataGrid x:Name="EmployeeDataGrid"
                                      ItemsSource="{Binding FilteredEmployees}"
                                    SelectedItem="{Binding SelectedEmployee}"
                                      AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                      RowDetailsVisibilityMode="VisibleWhenSelected"
                                      GridLinesVisibility="Vertical"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}"
                                           BasedOn="{StaticResource DataGridRowBaseStyle}">
                                        <EventSetter Event="PreviewMouseLeftButtonDown"
                                                     Handler="EmployeeRow_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp"
                                                     Handler="EmployeeRow_PreviewMouseLeftButtonUp"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="8,6"
                                                Visibility="{Binding DataContext.IsAdminScreen, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Chỉnh sửa"
                                                        Tag="{Binding}"
                                                        Click="EditEmployeeContact_Click"
                                                        Padding="12,7"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="Xóa hồ sơ"
                                                        Tag="{Binding}"
                                                        Click="DeleteEmployeeProfile_Click"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="12,7"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Họ tên"
                                            Binding="{Binding FullName}"
                                            Width="*"/>
                                    <DataGridTextColumn Header="Điện thoại"
                                            Binding="{Binding Phone}"
                                            Width="1.2*"/>
                                    <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="2*"/>
                                    <DataGridTemplateColumn Header="Đang làm việc" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton IsChecked="{Binding IsEmployeeActive, Mode=OneWay}"
                                                              Tag="{Binding}"
                                                              Click="ToggleEmployeeStatus_Click"
                                                              HorizontalAlignment="Center">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="{x:Type ToggleButton}"
                                                               BasedOn="{StaticResource StateSwitchStyle}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.IsManagerScreen, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                                   Value="True"/>
                                                                        <Condition Binding="{Binding IsEmployeeActive}"
                                                                                   Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="IsEnabled"
                                                                            Value="False"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Audit Log"
                         Visibility="{Binding IsAdminScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Nhật ký hoạt động"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="Tối đa 500 bản ghi gần nhất; chọn dòng để xem chi tiết thay đổi."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,10">
                                <TextBox Width="280"
                                         Text="{Binding AuditLogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tìm người thao tác, đối tượng hoặc nội dung"
                                         Margin="0,0,8,8"/>
                                <ComboBox Width="170"
                                          ItemsSource="{Binding AuditLogCategoryFilters}"
                                          SelectedItem="{Binding SelectedAuditLogCategoryFilter}"
                                          ToolTip="Lọc theo nhóm"
                                          Margin="0,0,8,8"/>
                                <ComboBox Width="170"
                                          ItemsSource="{Binding AuditLogActionFilters}"
                                          SelectedItem="{Binding SelectedAuditLogActionFilter}"
                                          ToolTip="Lọc theo hành động"
                                          Margin="0,0,8,8"/>
                                <DatePicker Width="150"
                                            SelectedDate="{Binding AuditLogFromDate}"
                                            ToolTip="Từ ngày"
                                            Margin="0,0,8,8"/>
                                <DatePicker Width="150"
                                            SelectedDate="{Binding AuditLogToDate}"
                                            ToolTip="Đến ngày"
                                            Margin="0,0,8,8"/>
                                <Button Content="Lọc / Làm mới"
                                        Command="{Binding LoadAuditLogsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Grid.Row="1"
                                Style="{StaticResource DataGridFrameStyle}">
                            <DataGrid ItemsSource="{Binding AuditLogs}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      RowDetailsVisibilityMode="VisibleWhenSelected"
                                      GridLinesVisibility="Vertical"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}">
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Summary}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời gian"
                                                        Binding="{Binding OccurredAtDisplay}"
                                                        Width="1.5*"/>
                                    <DataGridTextColumn Header="Người thao tác"
                                                        Binding="{Binding ActorUsername}"
                                                        Width="1.3*"/>
                                    <DataGridTextColumn Header="Vai trò"
                                                        Binding="{Binding ActorRole}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Nhóm"
                                                        Binding="{Binding CategoryDisplay}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Hành động"
                                                        Binding="{Binding ActionDisplay}"
                                                        Width="1.2*"/>
                                    <DataGridTextColumn Header="Đối tượng"
                                                        Binding="{Binding TargetDisplay}"
                                                        Width="2*"/>
                                    <DataGridTextColumn Header="Tóm tắt"
                                                        Binding="{Binding Summary}"
                                                        Width="2.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Bàn ăn"
                         Visibility="{Binding IsManagerScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                Text="Quản lý bàn ăn"
                                FontSize="20"
                                   FontWeight="SemiBold"
                                Margin="0,0,0,12"/>
                        <WrapPanel Grid.Row="1"
                                Margin="0,0,0,12">
                            <TextBox Width="260"
                                    Text="{Binding TableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tìm theo số hiệu bàn hoặc khu vực"
                                     Margin="0,0,8,8"/>
                            <ComboBox Width="200"
                                    ItemsSource="{Binding TableAreaFilters}"
                                      SelectedItem="{Binding SelectedTableAreaFilter}"
                                      ToolTip="Lọc theo khu vực"
                                      Margin="0,0,8,8"/>
                            <ComboBox Width="220"
                                    ItemsSource="{Binding TableServiceStatusFilters}"
                                      SelectedItem="{Binding SelectedTableServiceStatusFilter}"
                                      ToolTip="Lọc theo trạng thái phục vụ"
                                      Margin="0,0,8,8"/>
                        </WrapPanel>
                        <Border Grid.Row="2"
                                Style="{StaticResource DataGridFrameStyle}"
                                MinHeight="180"
                                Margin="0,0,0,16">
                            <DataGrid ItemsSource="{Binding FilteredTables}"
                                    SelectedItem="{Binding SelectedTable}"
                                      AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                      GridLinesVisibility="Vertical"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Số hiệu bàn"
                                            Binding="{Binding TableNumber}"
                                            Width="1.2*"
                                            MinWidth="130"/>
                                    <DataGridTextColumn Header="Số chỗ ngồi"
                                            Binding="{Binding SeatCount}"
                                            Width="0.9*"
                                            MinWidth="115"/>
                                    <DataGridTextColumn Header="Khu vực"
                                            Binding="{Binding Area}"
                                            Width="1.15*"
                                            MinWidth="120"/>
                                    <DataGridTextColumn Header="Trạng thái"
                                            Binding="{Binding OpenOrderStatus}"
                                            Width="1.15*"
                                            MinWidth="120"/>
                                    <DataGridTemplateColumn Header="Phục vụ" Width="1.35*" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                              Tag="{Binding DataContext.ToggleTableStatusCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                              IsEnabled="{Binding CanToggleServiceStatus}"
                                                              Style="{StaticResource StateSwitchStyle}"
                                                              ToolTip="Bật hoặc tắt phục vụ bàn"
                                                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <StackPanel Grid.Row="3"
                                behaviors:DataGridSelectionBehavior.PreserveSelectionOnClick="True">
                            <WrapPanel Margin="0,0,0,12">
                                <StackPanel Width="200"
                                        Margin="0,0,12,8">
                                    <TextBlock Text="Khu vực"/>
                                    <ComboBox ItemsSource="{Binding TableAreas}"
                                              SelectedItem="{Binding TableAreaText}"
                                              behaviors:DataGridSelectionBehavior.PreserveSelectionOnClick="True"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Width="200"
                                        Margin="0,0,12,8">
                                    <TextBlock Text="Số hiệu bàn"/>
                                    <TextBox Text="{Binding TableNumberText, UpdateSourceTrigger=PropertyChanged}"
                                             behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Ví dụ: Bàn 1, A1 hoặc Bàn cửa sổ"
                                             Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Width="160"
                                        Margin="0,0,12,8">
                                    <TextBlock Text="Số chỗ ngồi"/>
                                    <TextBox Text="{Binding TableSeatCountText, UpdateSourceTrigger=PropertyChanged}"
                                            behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Ví dụ: 4"
                                            Margin="0,4,0,0"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Thêm bàn"
                                        Command="{Binding CreateTableCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"/>
                                <Button Content="Cập nhật bàn đã chọn"
                                        Command="{Binding UpdateTableCommand}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"/>
                                <Button Content="Xóa bàn"
                                        Click="DeleteTable_Click"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Thực đơn"
                         Visibility="{Binding IsManagerScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabControl Margin="12">
                        <TabItem Header="Danh mục">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Quản lý danh mục"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.55*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Danh sách danh mục"
                                                    FontSize="16"
                                                       FontWeight="SemiBold"
                                                    Margin="0,0,0,12"/>
                                            <Border Grid.Row="1"
                                                    Style="{StaticResource DataGridFrameStyle}">
                                                <DataGrid ItemsSource="{Binding Categories}"
                                                          SelectedItem="{Binding SelectedCategory}"
                                                          AutoGenerateColumns="False"
                                                        IsReadOnly="True"
                                                          CanUserAddRows="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Tên danh mục"
                                                                Binding="{Binding Name}"
                                                                Width="*"/>
                                                        <DataGridTextColumn Header="Số món"
                                                                Binding="{Binding ProductCount}"
                                                                Width="0.65*"/>
                                                        <DataGridTemplateColumn Header="Kinh doanh" Width="0.85*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                                  Tag="{Binding DataContext.ToggleCategoryStatusCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                                  Style="{StaticResource StateSwitchStyle}"
                                                                                  ToolTip="Bật hoặc tắt kinh doanh danh mục"
                                                                                  HorizontalAlignment="Center"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="16"
                                            behaviors:DataGridSelectionBehavior.PreserveSelectionOnClick="True">
                                        <StackPanel>
                                            <TextBlock Text="Thông tin danh mục"
                                                    FontSize="16"
                                                       FontWeight="SemiBold"
                                                    Margin="0,0,0,14"/>
                                            <TextBlock Text="Tên danh mục"/>
                                            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                                     behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tên danh mục"
                                                     Margin="0,4,0,12"/>
                                            <WrapPanel>
                                                <Button Content="Thêm danh mục"
                                                        Command="{Binding CreateCategoryCommand}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="12,7"
                                                        Margin="0,0,8,8"/>
                                                <Button Content="Cập nhật"
                                                        Command="{Binding UpdateCategoryCommand}"
                                                        Padding="12,7"
                                                        Margin="0,0,8,8"/>
                                                <Button Content="Xóa danh mục"
                                                        Click="DeleteCategory_Click"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="12,7"
                                                        Margin="0,0,8,8"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Món ăn">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Quản lý món ăn"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.7*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="0.85*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Danh sách món"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                       Margin="0,0,0,10"/>
                                            <WrapPanel Grid.Row="1"
                                                    Margin="0,0,0,8">
                                                <TextBox Width="260"
                                                         Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tìm theo tên món, tags hoặc danh mục"
                                                         Margin="0,0,8,8"/>
                                                <ComboBox Width="210"
                                                        ItemsSource="{Binding ProductCategoryFilters}"
                                                          SelectedItem="{Binding SelectedProductCategoryFilter}"
                                                          ToolTip="Lọc theo danh mục"
                                                        Margin="0,0,8,8"/>
                                            </WrapPanel>
                                            <Border Grid.Row="2"
                                                    Style="{StaticResource DataGridFrameStyle}">
                                                <DataGrid ItemsSource="{Binding Products}"
                                                          SelectedItem="{Binding SelectedProduct}"
                                                          AutoGenerateColumns="False"
                                                        IsReadOnly="True"
                                                          CanUserAddRows="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Tên món"
                                                                Binding="{Binding Name}"
                                                                Width="*"/>
                                                        <DataGridTextColumn Header="Danh mục"
                                                                Binding="{Binding CategoryName}"
                                                                Width="1*"/>
                                                        <DataGridTextColumn Header="Tags"
                                                                Binding="{Binding Tags}"
                                                                Width="1.2*"/>
                                                        <DataGridTextColumn Header="Giá bán"
                                                                            Binding="{Binding Price, StringFormat={}{0:N0}}"
                                                                            Width="0.8*"/>
                                                        <DataGridTemplateColumn Header="Còn món" Width="0.7*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ToggleButton IsChecked="{Binding IsAvailable, Mode=OneWay}"
                                                                                  Tag="{Binding DataContext.ToggleProductAvailabilityCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                                  IsEnabled="{Binding DataContext.CanToggleProductAvailability, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                                  Style="{StaticResource StateSwitchStyle}"
                                                                                  ToolTip="Bật hoặc tắt tình trạng còn món"
                                                                                  HorizontalAlignment="Center"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="Kinh doanh" Width="0.8*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                                  Tag="{Binding DataContext.ToggleProductStatusCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                                  Style="{StaticResource StateSwitchStyle}"
                                                                                  ToolTip="Bật hoặc tắt kinh doanh món"
                                                                                  HorizontalAlignment="Center"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="16"
                                            behaviors:DataGridSelectionBehavior.PreserveSelectionOnClick="True">
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                            <StackPanel>
                                                <TextBlock Text="Thông tin món"
                                                        FontSize="16"
                                                           FontWeight="SemiBold"
                                                        Margin="0,0,0,14"/>
                                                <TextBlock Text="Tên món"/>
                                                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                                         behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tên món"
                                                         Margin="0,4,0,12"/>
                                                <TextBlock Text="Giá bán"/>
                                                <TextBox Text="{Binding ProductPriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Giá bán (đồng)"
                                                         Margin="0,4,0,12"/>
                                                <TextBlock Text="Danh mục"/>
                                                <ComboBox ItemsSource="{Binding Categories}"
                                                        DisplayMemberPath="Name"
                                                          SelectedItem="{Binding SelectedProductCategory}"
                                                          behaviors:ComboBoxPlaceholderBehavior.PlaceholderText="Chọn danh mục"
                                                          Margin="0,4,0,12"/>
                                                <TextBlock Text="Tags"/>
                                                <ToggleButton x:Name="ProductTagsDropDownButton"
                                                              Content="{Binding ProductTagsDisplay}"
                                                              IsChecked="{Binding IsProductTagsDropDownOpen, Mode=TwoWay}"
                                                              Style="{StaticResource ProductTagsDropDownButtonStyle}"
                                                              Margin="0,4,0,14"/>
                                                <Popup PlacementTarget="{Binding ElementName=ProductTagsDropDownButton}"
                                                       Placement="Bottom"
                                                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                       IsOpen="{Binding PlacementTarget.DataContext.IsProductTagsDropDownOpen, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True">
                                                    <Border Width="320"
                                                            MaxHeight="220"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="8"
                                                            Margin="0,5,0,0">
                                                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                                            <ItemsControl ItemsSource="{Binding ProductTagOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Content="{Binding Name}"
                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  Style="{StaticResource ProductTagCheckBoxStyle}"
                                                                                  Padding="8,7"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                                <WrapPanel>
                                                    <Button Content="Thêm món"
                                                            Command="{Binding CreateProductCommand}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Padding="12,7"
                                                            Margin="0,0,8,8"/>
                                                    <Button Content="Cập nhật"
                                                            Command="{Binding UpdateProductCommand}"
                                                            Padding="12,7"
                                                            Margin="0,0,8,8"/>
                                                    <Button Content="Xóa món"
                                                            Click="DeleteProduct_Click"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="12,7"
                                                            Margin="0,0,8,8"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Khuyến mãi">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Quản lý khuyến mãi"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.55*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="0.85*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14">
                                        <DataGrid ItemsSource="{Binding Promotions}"
                                                  SelectedItem="{Binding SelectedPromotion}"
                                                  AutoGenerateColumns="False"
                                                IsReadOnly="True"
                                                  CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tên khuyến mãi"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>
                                                <DataGridTextColumn Header="Giảm (%)"
                                                                    Binding="{Binding DiscountPercentage, StringFormat={}{0:0.##}%}"
                                                                    Width="0.7*"/>
                                                <DataGridTextColumn Header="Áp dụng cho"
                                                                    Binding="{Binding TargetName}"
                                                                    Width="1.2*"/>
                                                <DataGridTextColumn Header="Thời gian"
                                                                    Binding="{Binding PeriodDisplay}"
                                                                    Width="1.1*"/>
                                                <DataGridTemplateColumn Header="Đang bật" Width="0.7*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                          Tag="{Binding DataContext.TogglePromotionStatusCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                          Style="{StaticResource StateSwitchStyle}"
                                                                          ToolTip="Bật hoặc tắt khuyến mãi"
                                                                          HorizontalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="16"
                                            behaviors:DataGridSelectionBehavior.PreserveSelectionOnClick="True">
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                            <StackPanel>
                                                <TextBlock Text="Thông tin khuyến mãi"
                                                        FontSize="16"
                                                           FontWeight="SemiBold"
                                                        Margin="0,0,0,14"/>
                                                <TextBlock Text="Tên chương trình"/>
                                                <TextBox Text="{Binding PromotionName, UpdateSourceTrigger=PropertyChanged}"
                                                         behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tên chương trình"
                                                         MaxLength="100"
                                                        Margin="0,4,0,12"/>
                                                <TextBlock Text="Mức giảm (%)"/>
                                                <TextBox Text="{Binding PromotionDiscountPercentageText, UpdateSourceTrigger=PropertyChanged}"
                                                         behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Phần trăm giảm (1–100)"
                                                         Margin="0,4,0,12"/>
                                                <TextBlock Text="Áp dụng theo"/>
                                                <ComboBox ItemsSource="{Binding PromotionTargetTypes}"
                                                          SelectedItem="{Binding SelectedPromotionTargetType}"
                                                          Margin="0,4,0,12"/>
                                                <StackPanel Visibility="{Binding IsPromotionProductTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Món áp dụng"/>
                                                    <ComboBox ItemsSource="{Binding PromotionProducts}"
                                                            DisplayMemberPath="Name"
                                                              SelectedItem="{Binding SelectedPromotionProduct}"
                                                                  behaviors:ComboBoxPlaceholderBehavior.PlaceholderText="Chọn món áp dụng"
                                                                  Margin="0,4,0,12"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsPromotionCategoryTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Danh mục áp dụng"/>
                                                    <ComboBox ItemsSource="{Binding Categories}"
                                                            DisplayMemberPath="Name"
                                                              SelectedItem="{Binding SelectedPromotionCategory}"
                                                                  behaviors:ComboBoxPlaceholderBehavior.PlaceholderText="Chọn danh mục áp dụng"
                                                                  Margin="0,4,0,12"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Bắt đầu từ"/>
                                                        <DatePicker SelectedDate="{Binding PromotionStartsAt}"
                                                                    HorizontalAlignment="Stretch"
                                                                    MinWidth="0"
                                                                    Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Kết thúc đến hết ngày"
                                                                   TextWrapping="Wrap"/>
                                                        <DatePicker SelectedDate="{Binding PromotionEndsAt}"
                                                                    HorizontalAlignment="Stretch"
                                                                    MinWidth="0"
                                                                    Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel>
                                                    <Button Content="Tạo khuyến mãi"
                                                            Command="{Binding CreatePromotionCommand}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Padding="12,7"
                                                            Margin="0,0,8,8"/>
                                                    <Button Content="Cập nhật"
                                                            Command="{Binding UpdatePromotionCommand}"
                                                            Padding="12,7"
                                                            Margin="0,0,8,8"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="Lịch sử"
                         Visibility="{Binding IsManagerScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource OrderHistoryViewTemplate}"/>
                </TabItem>
                <TabItem Header="Báo cáo"
                         Visibility="{Binding IsManagerScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Báo cáo doanh thu"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <WrapPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Từ ngày"/>
                                    <DatePicker SelectedDate="{Binding SalesReportFromDate}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Đến hết ngày"/>
                                    <DatePicker SelectedDate="{Binding SalesReportToDate}"/>
                                </StackPanel>
                                <Button Content="Xem báo cáo"
                                        Command="{Binding RefreshSalesReportCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="12,7"
                                        Margin="0,19,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Đơn đã thanh toán"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SalesReport.PaidOrderCount}"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Doanh thu trước giảm"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SalesReport.GrossRevenue, StringFormat={}{0:N0} đ}"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Tổng giảm giá"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SalesReport.DiscountTotal, StringFormat={}{0:N0} đ}"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3"
                                    Background="{StaticResource PrimaryTintBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Doanh thu thực nhận"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SalesReport.NetRevenue, StringFormat={}{0:N0} đ}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource DataGridFrameStyle}">
                                <DataGrid ItemsSource="{Binding SalesReport.PaymentMethods}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Phương thức"
                                                            Binding="{Binding MethodDisplay}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Số giao dịch"
                                                            Binding="{Binding PaymentCount}"
                                                            Width="0.9*"/>
                                        <DataGridTextColumn Header="Doanh thu"
                                                            Binding="{Binding TotalAmount, StringFormat={}{0:N0} đ}"
                                                            Width="1.2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource DataGridFrameStyle}">
                                <DataGrid ItemsSource="{Binding SalesReport.TopSellingProducts}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Món bán chạy"
                                                            Binding="{Binding ProductName}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Số lượng"
                                                            Binding="{Binding QuantitySold}"
                                                            Width="0.75*"/>
                                        <DataGridTextColumn Header="Doanh thu gộp"
                                                            Binding="{Binding GrossRevenue, StringFormat={}{0:N0} đ}"
                                                            Width="1.2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <TabControl x:Name="StaffWorkspaceTabs"
                    Grid.Row="3"
                    SelectedIndex="{Binding SelectedStaffWorkspaceIndex}"
                        Visibility="{Binding IsStaffScreen, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0">
                <TabItem Header="Chọn bàn"
                         Visibility="{Binding IsStaffOrderScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Chọn bàn"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBox Width="220"
                                         Text="{Binding OrderTableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tìm theo số hiệu bàn"
                                         Margin="0,0,8,8"/>
                                <ComboBox Width="170"
                                          ItemsSource="{Binding OrderTableAreaFilters}"
                                          SelectedItem="{Binding SelectedOrderTableAreaFilter}"
                                          behaviors:ComboBoxPlaceholderBehavior.PlaceholderText="Tất cả khu vực"
                                          Margin="0,0,8,8"/>
                                <ComboBox Width="190"
                                          ItemsSource="{Binding OrderTableStatusFilters}"
                                          SelectedItem="{Binding SelectedOrderTableStatusFilter}"
                                          behaviors:ComboBoxPlaceholderBehavior.PlaceholderText="Tất cả trạng thái"
                                          Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Grid.Row="1"
                                Style="{StaticResource DataGridFrameStyle}">
                            <DataGrid ItemsSource="{Binding FilteredOrderTables}"
                                      x:Name="OrderTablesDataGrid"
                                      SelectedItem="{Binding SelectedOrderTable}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Vertical"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Số hiệu bàn"
                                                        Binding="{Binding TableNumber}"
                                                        Width="1.2*"
                                                        MinWidth="110"/>
                                    <DataGridTextColumn Header="Chỗ ngồi"
                                                        Binding="{Binding SeatCount}"
                                                        Width="0.65*"
                                                        MinWidth="75"/>
                                    <DataGridTextColumn Header="Khu vực"
                                                        Binding="{Binding Area}"
                                                        Width="1.1*"
                                                        MinWidth="105"/>
                                    <DataGridTextColumn Header="Trạng thái"
                                                        Binding="{Binding OccupancyStatus}"
                                                        Width="1.15*"
                                                        MinWidth="105"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Grid.Row="2"
                                   Margin="0,10,0,0"
                                   behaviors:DataGridSelectionBehavior.PreserveSelectionOnClick="True">
                            <Button Content="Bắt đầu order"
                                    Command="{Binding StartOrderCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,7"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Order"
                         Visibility="{Binding IsStaffOrderScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{Binding OrderTabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="OrderTabBorder"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Background="{StaticResource SurfaceMutedBrush}"
                                                    CornerRadius="8"
                                                    Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="OrderTabSelectButton"
                                                            Content="{Binding Title}"
                                                            Command="{Binding DataContext.SelectOrderTabCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="12,8"/>
                                                    <Button Content="×"
                                                            Command="{Binding DataContext.CloseOrderTabCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Đóng tab; order vẫn được giữ"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8,4"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="OrderTabBorder"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="OrderTabBorder"
                                                            Property="BorderThickness"
                                                            Value="2"/>
                                                    <Setter TargetName="OrderTabBorder"
                                                            Property="Background"
                                                            Value="{StaticResource PrimaryTintBrush}"/>
                                                    <Setter TargetName="OrderTabSelectButton"
                                                            Property="Foreground"
                                                            Value="{StaticResource PrimaryDarkBrush}"/>
                                                    <Setter TargetName="OrderTabSelectButton"
                                                            Property="FontWeight"
                                                            Value="Bold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Column="1"
                                    Content="+"
                                    Command="{Binding NewOrderTabCommand}"
                                    ToolTip="Mở tab order mới"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,5"
                                    Margin="8,0,0,0"/>
                        </Grid>
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                behaviors:DataGridSelectionBehavior.PreserveSelectionOnClick="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Chọn danh mục món"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <TabControl Grid.Row="1"
                                            Grid.RowSpan="2"
                                            ItemsSource="{Binding OrderProductGroups}"
                                            SelectedItem="{Binding SelectedOrderProductGroup}">
                                    <TabControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CategoryName}"/>
                                        </DataTemplate>
                                    </TabControl.ItemTemplate>
                                    <TabControl.ContentTemplate>
                                        <DataTemplate>
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                                <ItemsControl ItemsSource="{Binding Products}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.AddOrderProductCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{StaticResource SurfaceMutedBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    Padding="10,8"
                                                                    Margin="0,0,8,8"
                                                                    MinWidth="150"
                                                                    MaxWidth="220">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               FontSize="12"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DataTemplate>
                                    </TabControl.ContentTemplate>
                                </TabControl>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="Chi tiết order"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="Order #"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentOpenOrder.OrderId}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Border Style="{StaticResource DataGridFrameStyle}"
                                        Margin="0,0,0,8">
                                    <DataGrid ItemsSource="{Binding CurrentOrderDetails}"
                                            SelectedItem="{Binding SelectedOrderDetail}"
                                            AutoGenerateColumns="False"
                                            RowHeaderWidth="0"
                                            HeadersVisibility="Column"
                                            IsReadOnly="True"
                                            CanUserAddRows="False"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            MinHeight="160"
                                            MaxHeight="250">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Món"
                                                    Binding="{Binding ProductName}"
                                                    IsReadOnly="True"
                                                    MinWidth="100"
                                                    Width="1.5*"/>
                                            <DataGridTextColumn Header="SL"
                                                    Binding="{Binding Quantity}"
                                                    MinWidth="58"
                                                    Width="0.65*"/>
                                            <DataGridTextColumn Header="Ghi chú"
                                                    Binding="{Binding Notes}"
                                                    IsReadOnly="True"
                                                    MinWidth="70"
                                                    Width="1.2*"/>
                                            <DataGridTextColumn Header="Đơn giá"
                                                    Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                                    IsReadOnly="True"
                                                    MinWidth="80"
                                                    Width="1*"/>
                                            <DataGridTextColumn Header="Thành tiền"
                                                    Binding="{Binding LineTotal, StringFormat={}{0:N0}}"
                                                    IsReadOnly="True"
                                                    MinWidth="90"
                                                    Width="1.1*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <WrapPanel Margin="0,0,0,10">
                                    <TextBox Width="220"
                                             Text="{Binding EditOrderItemNotes, UpdateSourceTrigger=PropertyChanged}"
                                             behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Ghi chú món (tùy chọn)"
                                             MaxLength="500"
                                             Margin="0,0,8,8"/>
                                    <Button Content="Cập nhật ghi chú"
                                            Command="{Binding UpdateOrderItemCommand}"
                                            Padding="12,5"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Bỏ món đã chọn"
                                            Command="{Binding RemoveOrderItemCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="12,5"
                                            Margin="0,0,8,8"/>
                                </WrapPanel>
                                <StackPanel HorizontalAlignment="Right"
                                        Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="Khuyến mãi: "
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentOpenOrder.PromotionName, TargetNullValue=Không có}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentOpenOrder.Subtotal, StringFormat=Tạm tính: {0:N0} đ}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding CurrentOpenOrder.DiscountAmount, StringFormat=Giảm giá: -{0:N0} đ}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding CurrentOpenOrder.Total, StringFormat=Thành tiền: {0:N0} đ}"
                                               FontSize="17"
                                            FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="Thanh toán tiền mặt"
                                            Click="CompleteCashPayment_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,7"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Chuyển khoản"
                                            Click="CompleteBankTransferPayment_Click"
                                            Padding="12,7"
                                            Margin="0,0,8,8"/>
                                </WrapPanel>
                                <Button Content="Hủy order"
                                        Click="CancelOpenOrder_Click"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="12,7"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Lịch sử">
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource OrderHistoryViewTemplate}"/>
                </TabItem>
                <TabItem Header="Thực đơn">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Danh sách thực đơn"
                                FontSize="20"
                                FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <WrapPanel Grid.Row="1"
                                Margin="0,0,0,8"
                                behaviors:DataGridSelectionBehavior.PreserveSelectionOnClick="True">
                            <TextBox Width="260"
                                    Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    behaviors:TextBoxPlaceholderBehavior.PlaceholderText="Tìm theo tên món, tags hoặc danh mục"
                                    Margin="0,0,8,8"/>
                            <ComboBox Width="210"
                                    ItemsSource="{Binding ProductCategoryFilters}"
                                      SelectedItem="{Binding SelectedProductCategoryFilter}"
                                      ToolTip="Lọc theo danh mục"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>
                        <Border Grid.Row="2"
                                Style="{StaticResource DataGridFrameStyle}">
                            <DataGrid ItemsSource="{Binding Products}"
                                    SelectedItem="{Binding SelectedProduct}"
                                      AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên món"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                                    <DataGridTextColumn Header="Danh mục"
                                            Binding="{Binding CategoryName}"
                                            Width="1.1*"/>
                                    <DataGridTextColumn Header="Tags"
                                            Binding="{Binding Tags}"
                                            Width="2*"/>
                                    <DataGridTextColumn Header="Giá bán"
                                            Binding="{Binding Price, StringFormat={}{0:N0}}"
                                            Width="0.9*"/>
                                    <DataGridTemplateColumn Header="Còn món" Width="0.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton IsChecked="{Binding IsAvailable, Mode=OneWay}"
                                                              Tag="{Binding DataContext.ToggleProductAvailabilityCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                              IsEnabled="{Binding DataContext.CanToggleProductAvailability, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                              Style="{StaticResource StateSwitchStyle}"
                                                              ToolTip="Bật hoặc tắt tình trạng còn món"
                                                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

        </Grid>
    </Grid>
</Window>
