<Window x:Class="RestaurantManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:RestaurantManagement.WPF.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static viewModels:MainWindowViewModel.Title}" Height="720" Width="1440" MinHeight="620" MinWidth="1120"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="30,30,30,0">
        <Grid Margin="0,0,0,30"
              Visibility="{Binding IsSetupScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="1050" MinHeight="560" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.12" Color="#542B1C" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="24,0,0,24" ClipToBounds="True">
                        <Grid Background="{StaticResource PrimaryBrush}">
                            <Ellipse Width="390" Height="390" Fill="#1FFFFFFF"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-120,0" />
                            <Ellipse Width="290" Height="290" Fill="#16FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-100" />
                            <StackPanel Margin="54" VerticalAlignment="Center">
                                <Border Width="148" Height="148" CornerRadius="22" Background="{StaticResource SurfaceBrush}"
                                        HorizontalAlignment="Left" Margin="0,0,0,26" Padding="8">
                                    <Image x:Name="SetupBrandLogo" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="DINEEASE · QUẢN LÝ NHÀ HÀNG" Foreground="#F6C28E" FontSize="12"
                                           FontWeight="Bold" Margin="0,0,0,14" />
                                <TextBlock Text="Vận hành gọn gàng.&#10;Phục vụ tận tâm."
                                           Foreground="White" FontSize="34" FontWeight="SemiBold"
                                           TextWrapping="Wrap" LineHeight="43" Margin="0,0,0,18" />
                                <TextBlock Text="Một nơi tập trung cho đội ngũ và hoạt động mỗi ngày."
                                           Foreground="#F4E7D8" FontSize="15" TextWrapping="Wrap" MaxWidth="360" />
                                <StackPanel Margin="0,36,0,0">
                                    <TextBlock Text="●   Quản lý bàn và thực đơn" Foreground="#FFF8EF" Margin="0,0,0,12" />
                                    <TextBlock Text="●   Phân quyền theo vai trò" Foreground="#FFF8EF" Margin="0,0,0,12" />
                                    <TextBlock Text="●   Dữ liệu lưu trên thiết bị của bạn" Foreground="#FFF8EF" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="54">
                        <TextBlock Text="Bắt đầu sử dụng" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Thiết lập Admin lần đầu" FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,28" />
                        <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SetupUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" />
                        <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="SetupPasswordBox" Tag="setup" PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,10" />
                        <TextBlock Text="Dùng ít nhất 12 ký tự để bảo vệ tài khoản." FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,22" />
                        <Button Content="Tạo tài khoản Admin" Command="{Binding CreateInitialAdminCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                        <Grid Width="390" HorizontalAlignment="Left" Margin="0,14,0,0">
                            <Border Background="{StaticResource DangerTintBrush}" CornerRadius="9" Padding="10"
                                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ErrorMessage}" ToolTip="{Binding ErrorMessage}"
                                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Background="{StaticResource PrimaryTintBrush}" CornerRadius="9" Padding="10">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                                           Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,30"
              Visibility="{Binding IsLoginScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="1050" MinHeight="560" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.12" Color="#542B1C" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="24,0,0,24" ClipToBounds="True">
                        <Grid Background="{StaticResource PrimaryBrush}">
                            <Ellipse Width="390" Height="390" Fill="#1FFFFFFF"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-120,0" />
                            <Ellipse Width="290" Height="290" Fill="#16FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-100" />
                            <StackPanel Margin="54" VerticalAlignment="Center">
                                <Border Width="148" Height="148" CornerRadius="22" Background="{StaticResource SurfaceBrush}"
                                        HorizontalAlignment="Left" Margin="0,0,0,26" Padding="8">
                                    <Image x:Name="LoginBrandLogo" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="DINEEASE · QUẢN LÝ NHÀ HÀNG" Foreground="#F6C28E" FontSize="12"
                                           FontWeight="Bold" Margin="0,0,0,14" />
                                <TextBlock Text="Vận hành gọn gàng.&#10;Phục vụ tận tâm."
                                           Foreground="White" FontSize="34" FontWeight="SemiBold"
                                           TextWrapping="Wrap" LineHeight="43" Margin="0,0,0,18" />
                                <TextBlock Text="Một nơi tập trung cho đội ngũ và hoạt động mỗi ngày."
                                           Foreground="#F4E7D8" FontSize="15" TextWrapping="Wrap" MaxWidth="360" />
                                <StackPanel Margin="0,36,0,0">
                                    <TextBlock Text="●   Quản lý bàn và thực đơn" Foreground="#FFF8EF" Margin="0,0,0,12" />
                                    <TextBlock Text="●   Phân quyền theo vai trò" Foreground="#FFF8EF" Margin="0,0,0,12" />
                                    <TextBlock Text="●   Dữ liệu lưu trên thiết bị của bạn" Foreground="#FFF8EF" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="54">
                        <TextBlock Text="Chào mừng trở lại" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Đăng nhập để tiếp tục quản lý nhà hàng"
                                   FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,28" />
                        <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" />
                        <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="LoginPasswordBox" Tag="login" PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,22" />
                        <Button Content="Đăng nhập" Command="{Binding SignInCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                        <Grid Width="390" HorizontalAlignment="Left" Margin="0,14,0,0">
                            <Border Background="{StaticResource DangerTintBrush}" CornerRadius="9" Padding="10"
                                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ErrorMessage}" ToolTip="{Binding ErrorMessage}"
                                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Background="{StaticResource PrimaryTintBrush}" CornerRadius="9" Padding="10">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                                           Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,30"
              Visibility="{Binding IsPasswordChangeRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="520" Background="{StaticResource SurfaceBrush}" CornerRadius="22"
                    Padding="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Đổi mật khẩu lần đầu" FontSize="26" FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Để bảo vệ tài khoản, bạn cần tạo mật khẩu riêng trước khi tiếp tục sử dụng."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,22" />
                    <TextBlock Text="Mật khẩu tạm" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <PasswordBox x:Name="RequiredCurrentPasswordBox" Tag="current"
                                 PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,16" />
                    <TextBlock Text="Mật khẩu mới (ít nhất 12 ký tự)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <PasswordBox x:Name="RequiredNewPasswordBox" Tag="new"
                                 PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,20" />
                    <Button Content="Đổi mật khẩu và tiếp tục" Command="{Binding ChangePasswordCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsAuthenticatedWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Height="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="10"
                            Background="{StaticResource SurfaceBrush}" Margin="0,0,10,0" Padding="3"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Image x:Name="HeaderBrandLogo" Stretch="Uniform" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="DINEEASE" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="2" Margin="38,27,0,0" VerticalAlignment="Top"
                          HorizontalAlignment="Left" Panel.ZIndex="1" IsHitTestVisible="False">
                        <Border MaxWidth="520" Background="{StaticResource DangerTintBrush}"
                                CornerRadius="9" Padding="10"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" ToolTip="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Border MaxWidth="520" Background="{StaticResource PrimaryTintBrush}"
                                CornerRadius="9" Padding="10">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                                       Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Grid>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14" Padding="5"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Button x:Name="AccountMenuButton" Click="AccountMenuButton_Click"
                            Padding="12,8"
                            Background="{StaticResource SurfaceMutedBrush}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserDescription}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Path Data="M0,0 L5,5 L10,0"
                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.6"
                                  Margin="12,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom"
                                         Background="{StaticResource SurfaceBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Padding="4">
                                <ContextMenu.Resources>
                                    <Style TargetType="{x:Type MenuItem}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="Padding" Value="14,9" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                                    <Border x:Name="MenuItemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <ContentPresenter ContentSource="Header"
                                                                          RecognizesAccessKey="True"
                                                                          Margin="{TemplateBinding Padding}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="MenuItemBorder"
                                                                    Property="Background"
                                                                    Value="{StaticResource PrimaryTintBrush}" />
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource PrimaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Đổi mật khẩu" Click="AccountChangePassword_Click" />
                                <Separator Margin="8,3" Background="{StaticResource BorderBrush}" />
                                <MenuItem Header="Đăng xuất" Click="AccountSignOut_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Border>
            </Grid>
            <ProgressBar Grid.Row="1" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TabControl x:Name="AdminWorkspaceTabs" Grid.Row="2"
                        Visibility="{Binding IsAdminScreen, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0" SelectionChanged="AdminTabs_SelectionChanged">
                <TabItem Header="Cấp tài khoản">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Cấp tài khoản đăng nhập cho nhân viên" FontSize="20"
                                       FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                                    <TextBlock Text="Họ tên" />
                                    <TextBox Text="{Binding AccountEmployeeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,8">
                                    <TextBlock Text="Điện thoại" />
                                    <TextBox Text="{Binding AccountEmployeePhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Email" />
                                    <TextBox Text="{Binding AccountEmployeeEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Tạo tài khoản"
                                    Command="{Binding CreateAccountCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,0,0,14" />
                            <Border Height="1" Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,12" />
                            <TextBlock Text="Tài khoản đã cấp" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        </StackPanel>
                        <DataGrid x:Name="AccountDataGrid" Grid.Row="1"
                                      ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      CanUserReorderColumns="False" CanUserResizeColumns="False"
                                      RowDetailsVisibilityMode="VisibleWhenSelected"
                                      GridLinesVisibility="Vertical"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      MinHeight="0" Margin="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}">
                                        <EventSetter Event="PreviewMouseLeftButtonDown"
                                                     Handler="AccountRow_PreviewMouseLeftButtonDown" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp"
                                                     Handler="AccountRow_PreviewMouseLeftButtonUp" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="8,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding ProfileActionLabel}"
                                                        Tag="{Binding}"
                                                        Click="CreateEmployeeProfile_Click"
                                                        IsEnabled="{Binding CanCreateEmployeeProfile}"
                                                        Padding="12,7" Margin="0,0,8,0" />
                                                <Button Content="Chỉnh sửa"
                                                        Tag="{Binding}"
                                                        Click="EditAccountEmployeeName_Click"
                                                        Padding="12,7" Margin="0,0,8,0" />
                                                <Button Content="{Binding AccountStatusActionLabel}"
                                                        Tag="{Binding}"
                                                        Click="ToggleAccountStatus_Click"
                                                        Padding="12,7" Margin="0,0,8,0" />
                                                <Button Content="Xóa tài khoản"
                                                        Tag="{Binding}"
                                                        Click="DeleteAccount_Click"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="12,7" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="2*" />
                                    <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="1.4*" />
                                    <DataGridTemplateColumn Header="Mật khẩu tạm" Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right"
                                                            Click="CopyTemporaryPassword_Click"
                                                            IsEnabled="{Binding CanCopyTemporaryPassword}"
                                                            Width="30" Height="30" MinHeight="0"
                                                            Padding="6" Margin="6,0,0,0"
                                                            ToolTip="Sao chép mật khẩu tạm"
                                                            AutomationProperties.Name="Sao chép mật khẩu tạm">
                                                        <Viewbox Width="14" Height="14">
                                                            <Path Fill="{StaticResource PrimaryBrush}"
                                                                  Data="M16,1H4C2.9,1 2,1.9 2,3V17H4V3H16V1M19,5H8C6.9,5 6,5.9 6,7V21C6,22.1 6.9,23 8,23H19C20.1,23 21,22.1 21,21V7C21,5.9 20.1,5 19,5M19,21H8V7H19V21Z" />
                                                        </Viewbox>
                                                    </Button>
                                                    <TextBlock Text="{Binding PasswordDisplay}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="*" />
                                    <DataGridCheckBoxColumn Header="Tài khoản hoạt động" Binding="{Binding IsAccountActive}" Width="1.4*" />
                                    <DataGridTextColumn Header="Hồ sơ nhân viên" Binding="{Binding ProfileActionLabel}" Width="1.3*" />
                                </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Nhân viên">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                        <StackPanel>
                            <TextBlock Text="Danh sách nhân viên" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      MinHeight="200" MaxHeight="280" Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*" />
                                    <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="130" />
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                                    <DataGridCheckBoxColumn Header="Đang làm việc" Binding="{Binding IsEmployeeActive}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Thêm hồ sơ nhân viên" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                                    <TextBlock Text="Họ tên" />
                                    <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,8">
                                    <TextBlock Text="Điện thoại" />
                                    <TextBox Text="{Binding EmployeePhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Email" />
                                    <TextBox Text="{Binding EmployeeEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Thêm nhân viên" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding CreateEmployeeCommand}" Padding="12,7"
                                    HorizontalAlignment="Left" Margin="0,0,0,18" />

                            <TextBlock Text="Hồ sơ nhân viên đã chọn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Lưu hồ sơ" Command="{Binding UpdateEmployeeCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Ngừng/kích hoạt nhân viên" Command="{Binding ToggleEmployeeStatusCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Xóa hồ sơ, giữ lịch sử" Click="DeleteEmployeeProfile_Click"
                                        Style="{StaticResource DangerButtonStyle}" Padding="12,7" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Bàn ăn">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                        <StackPanel>
                            <TextBlock Text="Quản lý bàn ăn" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <DataGrid ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      MinHeight="180" MaxHeight="260" Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Số bàn" Binding="{Binding TableNumber}" Width="120" />
                                    <DataGridTextColumn Header="Số chỗ ngồi" Binding="{Binding SeatCount}" Width="140" />
                                    <DataGridCheckBoxColumn Header="Đang phục vụ" Binding="{Binding IsOccupied}" Width="140" />
                                    <DataGridCheckBoxColumn Header="Đang sử dụng" Binding="{Binding IsActive}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,0,0,12">
                                <StackPanel Width="160" Margin="0,0,12,8">
                                    <TextBlock Text="Số bàn" />
                                    <TextBox Text="{Binding TableNumberText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,12,8">
                                    <TextBlock Text="Số chỗ ngồi" />
                                    <TextBox Text="{Binding TableSeatCountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Thêm bàn" Command="{Binding CreateTableCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Cập nhật bàn đã chọn" Command="{Binding UpdateTableCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Ngừng/kích hoạt bàn" Command="{Binding ToggleTableStatusCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Xóa bàn chưa sử dụng" Click="DeleteTable_Click"
                                        Style="{StaticResource DangerButtonStyle}" Padding="12,7" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Thực đơn">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                        <StackPanel>
                            <TextBlock Text="Danh mục món ăn" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      MinHeight="120" MaxHeight="200" Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên danh mục" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="2*" />
                                    <DataGridTextColumn Header="Số món" Binding="{Binding ProductCount}" Width="100" />
                                    <DataGridCheckBoxColumn Header="Đang kinh doanh" Binding="{Binding IsActive}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,0,0,8">
                                <StackPanel Width="240" Margin="0,0,12,8">
                                    <TextBlock Text="Tên danh mục" />
                                    <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Width="360" Margin="0,0,12,8">
                                    <TextBlock Text="Mô tả" />
                                    <TextBox Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,16">
                                <Button Content="Thêm danh mục" Command="{Binding CreateCategoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Cập nhật danh mục" Command="{Binding UpdateCategoryCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Ngừng/kích hoạt danh mục" Command="{Binding ToggleCategoryStatusCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Xóa danh mục trống" Click="DeleteCategory_Click"
                                        Style="{StaticResource DangerButtonStyle}" Padding="12,7" Margin="0,0,8,8" />
                            </WrapPanel>

                            <TextBlock Text="Món ăn" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <WrapPanel Margin="0,0,0,10">
                                <TextBox Width="220" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Tìm theo tên món, mô tả hoặc danh mục" Margin="0,0,8,8" />
                                <ComboBox Width="220" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedFilterCategory}" ToolTip="Lọc theo danh mục"
                                          Margin="0,0,8,8" />
                                <Button Content="Tìm kiếm" Command="{Binding SearchProductsCommand}" Padding="12,5" Margin="0,0,8,8" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      MinHeight="180" MaxHeight="260" Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên món" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="160" />
                                    <DataGridTextColumn Header="Giá bán" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="130" />
                                    <DataGridCheckBoxColumn Header="Còn món" Binding="{Binding IsAvailable}" Width="100" />
                                    <DataGridCheckBoxColumn Header="Đang kinh doanh" Binding="{Binding IsActive}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,0,0,8">
                                <StackPanel Width="240" Margin="0,0,12,8">
                                    <TextBlock Text="Tên món" />
                                    <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,12,8">
                                    <TextBlock Text="Giá bán" />
                                    <TextBox Text="{Binding ProductPriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,8">
                                    <TextBlock Text="Danh mục" />
                                    <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedProductCategory}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Width="320" Margin="0,0,12,8">
                                    <TextBlock Text="Đường dẫn ảnh (tùy chọn)" />
                                    <TextBox Text="{Binding ProductImagePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Width="480" Margin="0,0,12,8">
                                    <TextBlock Text="Mô tả" />
                                    <TextBox Text="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Thêm món" Command="{Binding CreateProductCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Cập nhật món" Command="{Binding UpdateProductCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Đánh dấu còn/hết món" Command="{Binding ToggleProductAvailabilityCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Ngừng/kích hoạt kinh doanh" Command="{Binding ToggleProductStatusCommand}" Padding="12,7" Margin="0,0,8,8" />
                                <Button Content="Xóa món chưa sử dụng" Click="DeleteProduct_Click"
                                        Style="{StaticResource DangerButtonStyle}" Padding="12,7" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <TabControl x:Name="StaffWorkspaceTabs" Grid.Row="2"
                        Visibility="{Binding IsStaffScreen, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0">
                <TabItem Header="Bàn ăn">
                    <DataGrid ItemsSource="{Binding Tables}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Margin="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số bàn" Binding="{Binding TableNumber}" Width="140" />
                            <DataGridTextColumn Header="Số chỗ ngồi" Binding="{Binding SeatCount}" Width="160" />
                            <DataGridCheckBoxColumn Header="Đang phục vụ" Binding="{Binding IsOccupied}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Thực đơn">
                    <DockPanel Margin="12">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox Width="220" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tìm theo tên món, mô tả hoặc danh mục" Margin="0,0,8,8" />
                            <ComboBox Width="220" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedFilterCategory}" ToolTip="Lọc theo danh mục"
                                      Margin="0,0,8,8" />
                            <Button Content="Tìm kiếm" Command="{Binding SearchProductsCommand}" Padding="12,5" Margin="0,0,8,8" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên món" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="180" />
                                <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="2*" />
                                <DataGridTextColumn Header="Giá bán" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="140" />
                                <DataGridCheckBoxColumn Header="Còn món" Binding="{Binding IsAvailable}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>

        </Grid>
    </Grid>
</Window>
